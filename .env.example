# ==============================================================================
# Financial Document Intelligence Backend - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real secrets to source control.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# AI Provider Selection ('gemini' is supported out of the box; extensible to 'claude', etc.)
AI_PROVIDER=gemini

# Google Gemini Configuration
# Paste your Google Gemini API Key here (Required for production AI features)
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Gemini Model Hierarchy Configuration (Configurable without altering code)
# Tier 1 - Simple invoices, receipts, predictable single-page documents
GEMINI_EXTRACTION_MODEL=gemini-3.6-flash
# Tier 2 - Multi-page, complex tabular grids, complex tax/discount structures
GEMINI_COMPLEX_EXTRACTION_MODEL=gemini-3.7-flash
# Tier 3 - Frontier escalation model for difficult statements, multi-currency, or repeated failures
GEMINI_ESCALATION_MODEL=gemini-3.8-flash
# Verification - Independent auditor model for second-pass document verification
GEMINI_VERIFICATION_MODEL=gemini-3.7-flash
# Chat - Interactive document Q&A assistant
GEMINI_CHAT_MODEL=gemini-3.6-flash

# Security & CORS Settings
# Comma-separated list of allowed origins (e.g., your React frontend URL)
# For local dev: http://localhost:5173,http://localhost:3000
# For production: https://your-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Limits & PDF Ingestion Safety
# Application-level maximum file limit (Strictly 25 MB)
MAX_UPLOAD_SIZE_MB=25
# Safe direct-upload threshold (Files <= 4 MB use direct multipart; > 4 MB use Private Vercel Blob)
DIRECT_UPLOAD_MAX_MB=4
MAX_PDF_PAGES=50
REQUEST_TIMEOUT_MS=60000
AI_TIMEOUT_MS=60000

# Private Vercel Blob Storage Secret (Backend/Vercel server-side ONLY)
BLOB_READ_WRITE_TOKEN=

# Rate Limiting & Resource Exhaustion Protection
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
MAX_CONCURRENT_PROCESSING=5
MAX_OUTPUT_SIZE_MB=20

# Extraction & Reconciliation Policy
MAX_EXTRACTION_RETRIES=2
MAX_ESCALATION_LEVELS=2

# ==============================================================================
# Secure Password Access Gate Configuration
# ==============================================================================
# Require password before allowing access to application and document processing (true/false)
REQUIRE_PASSWORD=true
# Confidential server-side secret password (NEVER commit to git or expose to frontend)
ACCESS_PASSWORD=
# Cryptographic secret for signing stateless short-lived access tokens (min 32 chars recommended)
ACCESS_TOKEN_SECRET=
# Access token expiration duration (e.g. 30m, 1h, 300s)
ACCESS_TOKEN_TTL=30m
# Authentication version for mass token invalidation without password change
ACCESS_AUTH_VERSION=1
# Rate limiting for verification endpoint (/api/v1/access/verify)
ACCESS_RATE_LIMIT_MAX=5
ACCESS_RATE_LIMIT_WINDOW_MS=60000
# Dedicated frontend domain (e.g. https://your-frontend.vercel.app)
FRONTEND_ORIGIN=

